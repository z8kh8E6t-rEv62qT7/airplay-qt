{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "E:/MSYS/clang64/bin/clang++.exe",
        "CMAKE_MAKE_PROGRAM": "E:/MSYS/clang64/bin/ninja.exe",
        "CMAKE_PREFIX_PATH": "E:/MSYS/clang64",
        "ASIO_SDK_ROOT": "E:/MSYS/clang64/include/asiosdk"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/msvc-deps/Library",
        "OPENSSL_ROOT_DIR": "${sourceDir}/build/msvc-deps/Library",
        "CMAKE_IGNORE_PREFIX_PATH": "E:/MSYS/clang64",
        "LIBPLIST_ROOT": "E:/MSYS/clang64",
        "ASIO_SDK_ROOT": "E:/MSYS/clang64/include/asiosdk"
      },
      "environment": {
        "PATH": "${sourceDir}/build/msvc/libplist;${sourceDir}/build/msvc-deps/Library/bin;${sourceDir}/build/msvc-deps/Library/lib/qt6/bin;C:/Windows/System32;E:/MSYS/usr/bin",
        "QT_PLUGIN_PATH": "${sourceDir}/build/msvc-deps/Library/lib/qt6/plugins",
        "QT_QPA_PLATFORM_PLUGIN_PATH": "${sourceDir}/build/msvc-deps/Library/lib/qt6/plugins/platforms"
      }
    },
    {
      "name": "macos-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OBJCXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "27.0",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt;/opt/homebrew/opt/openssl@3",
        "AIRPLAY_BUILD_STANDALONE": "ON",
        "AIRPLAY_BUILD_VST3": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AIRPLAY_BUILD_STANDALONE": "ON",
        "AIRPLAY_BUILD_VST3": "OFF",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AIRPLAY_BUILD_STANDALONE": "ON",
        "AIRPLAY_BUILD_VST3": "OFF",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "jobs": 6
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "jobs": 6
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
