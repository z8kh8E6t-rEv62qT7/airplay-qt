cmake_minimum_required(VERSION 3.25)
if(NOT CONFIG STREQUAL "Release" OR "@AIRPLAY_CLI_TEST@" OR
    NOT "@CMAKE_OSX_ARCHITECTURES@" STREQUAL "arm64" OR
    NOT "@CMAKE_OSX_DEPLOYMENT_TARGET@" STREQUAL "27.0")
  message(FATAL_ERROR "Packaging requires Release, arm64, macOS 27.0 and AIRPLAY_CLI_TEST=OFF")
endif()
set(BUILD_ROOT "@PROJECT_BINARY_DIR@")
set(SOURCE_ROOT "@PROJECT_SOURCE_DIR@")
set(QT_VERSION "@Qt6Core_VERSION@")
set(stage "${BUILD_ROOT}/package-macos-stage")
set(payload "${stage}/AirPlayQt-macos-arm64")
set(destination "${SOURCE_ROOT}/dist/macos-arm64")
file(MAKE_DIRECTORY "${SOURCE_ROOT}/dist")
file(LOCK "${SOURCE_ROOT}/dist/.package-macos.lock" GUARD PROCESS TIMEOUT 0)
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${payload}")
set(REPORT "${stage}/packaging.txt")
file(WRITE "${REPORT}" "")
include("${SOURCE_ROOT}/cmake/MacBundle.cmake")
include("${SOURCE_ROOT}/cmake/MacLicenses.cmake")

get_filename_component(qt_bin "@AIRPLAY_MACDEPLOYQT@" DIRECTORY)
execute_process(COMMAND "${qt_bin}/qtpaths" --query QT_INSTALL_PLUGINS
  OUTPUT_VARIABLE qt_plugins OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(cocoa "${qt_plugins}/platforms/libqcocoa.dylib")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM macos+macho)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL otool)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND /usr/bin/otool)
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${APP}/Contents/MacOS/AirPlayQt"
  MODULES "${PLUGIN}/Contents/MacOS/AirPlayQt" "${cocoa}"
  PRE_EXCLUDE_REGEXES "^/System/Library/" "^/usr/lib/"
  RESOLVED_DEPENDENCIES_VAR originals UNRESOLVED_DEPENDENCIES_VAR unresolved
  CONFLICTING_DEPENDENCIES_PREFIX conflicts)
if(unresolved OR conflicts_FILENAMES)
  message(FATAL_ERROR "Unresolved/conflicting dependencies: ${unresolved}; ${conflicts_FILENAMES}")
endif()
set(app "${payload}/AirPlayQt.app")
set(plugin "${payload}/AirPlayQt.vst3")
mac_run("Stage app" /usr/bin/ditto "${APP}" "${app}")
mac_run("Stage VST3" /usr/bin/ditto "${PLUGIN}" "${plugin}")
file(MAKE_DIRECTORY "${app}/Contents/PlugIns/platforms")
file(COPY "${cocoa}" DESTINATION "${app}/Contents/PlugIns/platforms")
mac_run("Qt official deployment" "@AIRPLAY_MACDEPLOYQT@" "${app}"
  -no-plugins -no-strip -no-codesign
  "-executable=${app}/Contents/PlugIns/platforms/libqcocoa.dylib")
file(WRITE "${app}/Contents/Resources/qt.conf" "[Paths]\nPlugins=PlugIns\n")
mac_run("Private VST frameworks" /usr/bin/ditto "${app}/Contents/Frameworks" "${plugin}/Contents/Frameworks")
mac_run("Private VST platform plugin" /usr/bin/ditto "${app}/Contents/PlugIns" "${plugin}/Contents/PlugIns")
mac_licenses("${originals}" "${app}/Contents/Resources/ThirdPartyLicenses")
mac_run("Private VST notices" /usr/bin/ditto "${app}/Contents/Resources/ThirdPartyLicenses"
  "${plugin}/Contents/Resources/ThirdPartyLicenses")
foreach(bundle IN ITEMS "${app}" "${plugin}")
  if(bundle STREQUAL plugin)
    mac_run("Minimum OS metadata" /usr/libexec/PlistBuddy -c "Add :LSMinimumSystemVersion string 27.0" "${bundle}/Contents/Info.plist")
  endif()
  mac_binaries("${bundle}" binaries)
  foreach(binary IN LISTS binaries)
    mac_rewrite("${binary}" "${bundle}/Contents/Frameworks")
  endforeach()
  mac_audit("${bundle}")
  mac_sign("${bundle}")
endforeach()

file(COPY "${REPORT}" DESTINATION "${payload}")
file(REMOVE_RECURSE "${destination}.previous")
if(EXISTS "${destination}")
  file(RENAME "${destination}" "${destination}.previous")
endif()
file(RENAME "${payload}" "${destination}" RESULT published)
if(NOT published STREQUAL "0")
  if(EXISTS "${destination}.previous")
    file(RENAME "${destination}.previous" "${destination}")
  endif()
  message(FATAL_ERROR "Publication failed: ${published}")
endif()
file(REMOVE_RECURSE "${destination}.previous")
message(STATUS "Packaged: ${destination}")
