set(DUMPBIN "@LIBPLIST_DUMPBIN@")
set(DEPENDENCY_BIN "@deploy_prefix@/bin")
get_filename_component(PLIST_BIN "@LIBPLIST_DLL@" DIRECTORY)
set(SCAN_ROOT "@PROJECT_BINARY_DIR@/runtime-scan")
include("@PROJECT_SOURCE_DIR@/cmake/CollectRuntime.cmake")
execute_process(COMMAND "${DUMPBIN}" /DEPENDENTS "${PLUGIN}"
  RESULT_VARIABLE inspect_result OUTPUT_VARIABLE imports ERROR_VARIABLE inspect_error)
if(NOT inspect_result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect loader imports: ${inspect_error}")
endif()
string(REGEX MATCHALL "[A-Za-z0-9_.-]+\\.[dD][lL][lL]" imported_dlls "${imports}")
foreach(dll IN LISTS imported_dlls)
  string(TOLOWER "${dll}" lower)
  if(NOT lower STREQUAL "kernel32.dll" AND NOT lower STREQUAL "bcrypt.dll")
    message(FATAL_ERROR "Unexpected loader dependency (static CRT required): ${dll}")
  endif()
endforeach()
get_filename_component(directory "${PLUGIN}" DIRECTORY)
set(destination "${directory}/runtime")
airplay_collect_runtime("${ENGINE}" "@AIRPLAY_QWINDOWS@" "${destination}")
file(COPY_FILE "${ENGINE}" "${destination}/AirPlayQtEngine.dll" ONLY_IF_DIFFERENT)
