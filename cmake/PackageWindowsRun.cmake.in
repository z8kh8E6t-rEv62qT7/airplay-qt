cmake_minimum_required(VERSION 3.25)
if(NOT CONFIG STREQUAL "Release")
  message(FATAL_ERROR "Windows packaging requires Release")
endif()
set(build_root "@PROJECT_BINARY_DIR@")
set(dist_root "@PROJECT_SOURCE_DIR@/dist")
file(MAKE_DIRECTORY "${dist_root}")
file(REAL_PATH "${build_root}" build_root)
file(REAL_PATH "${dist_root}" dist_root)
set(stage "${build_root}/package-windows-stage")
set(payload "${stage}/windows-x64")
set(destination "${dist_root}/windows-x64")
set(previous "${destination}.previous")
file(LOCK "${dist_root}/.package-windows.lock" GUARD PROCESS TIMEOUT 0)
# Check every tree that may be removed or moved before touching it.
foreach(path IN ITEMS "${stage}" "${destination}" "${previous}")
  if(IS_SYMLINK "${path}")
    message(FATAL_ERROR "Refusing redirected package directory: ${path}")
  endif()
  if(EXISTS "${path}")
    file(REAL_PATH "${path}" resolved)
    if(NOT resolved STREQUAL path)
      message(FATAL_ERROR "Refusing redirected package directory: ${path}")
    endif()
  endif()
endforeach()
if(EXISTS "${previous}")
  message(FATAL_ERROR "Previous package backup exists; recover or remove it first: ${previous}")
endif()
file(REMOVE_RECURSE "${stage}")
set(app "${payload}/AirPlayQt/AirPlayQt.exe")
set(bundle "${payload}/AirPlayQt.vst3")
set(plugin "${bundle}/Contents/x86_64-win/AirPlayQt.vst3")
file(MAKE_DIRECTORY "${payload}/AirPlayQt" "${bundle}/Contents/x86_64-win"
  "${bundle}/Contents/Resources")
file(COPY_FILE "${APP}" "${app}")
file(COPY_FILE "${PLUGIN}" "${plugin}")
# Reuse dependency resolution, without copying the mixed build directory.
execute_process(COMMAND "@CMAKE_COMMAND@" "-DAPP=${app}" "-DQT_BIN=${QT_BIN}"
  -P "${build_root}/DeployStandaloneRuntime.cmake" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "@CMAKE_COMMAND@" "-DPLUGIN=${plugin}"
  "-DENGINE=${ENGINE}" "-DQT_BIN=${QT_BIN}"
  -P "${build_root}/src/vst3/DeployVstRuntime.cmake" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${MODULEINFO}" -create -version "@PROJECT_VERSION@"
  -path "${bundle}" -output "${bundle}/Contents/Resources/moduleinfo.json"
  COMMAND_ERROR_IS_FATAL ANY)

# Publish only after all copies and dependency scans have succeeded.
if(EXISTS "${destination}")
  file(RENAME "${destination}" "${previous}")
endif()
file(RENAME "${payload}" "${destination}" RESULT published)
if(NOT published STREQUAL "0")
  if(EXISTS "${previous}")
    file(RENAME "${previous}" "${destination}" RESULT restored)
    if(NOT restored STREQUAL "0")
      message(FATAL_ERROR "Publication failed: ${published}; restore ${previous} manually: ${restored}")
    endif()
  endif()
  message(FATAL_ERROR "Publication failed: ${published}")
endif()
file(REMOVE_RECURSE "${previous}")
message(STATUS "Windows package: ${destination} (runtime tests not run)")
